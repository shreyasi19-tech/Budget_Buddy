# ---- Server side (used by server.ts) ----
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ---- Client side (used by src/lib/firebase.ts) ----
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
# Optional: only set if you're using a named Firestore database (not "(default)")
VITE_FIREBASE_FIRESTORE_DB_ID=""
